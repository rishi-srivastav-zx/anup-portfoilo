# Root level gitignore for monorepo / multi-app structure

# Dependencies
node_modules/
*/node_modules/
/.pnp
.pnp.*

# Build outputs
.next/
*/.next/
/out/
*/out/
/build/
*/build/
/dist/
*/dist/

# Test coverage
coverage/
*/coverage/

# Misc
.DS_Store
Thumbs.db
*.pem
*.log

# Environment variables
.env
.env.*
!.env.example
!*/.env.example

# Vercel
.vercel/

# TypeScript cache
*.tsbuildinfo
