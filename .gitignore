# Root level gitignore for monorepo / multi-app structure

# Dependencies
node_modules/
*/node_modules/
/.pnp
.pnp.*

# Build outputs
.next/
*/.next/
/out/
*/out/
/build/
*/build/
/dist/
*/dist/

# Test coverage
coverage/
*/coverage/

# Misc
.DS_Store
Thumbs.db
*.pem
*.log

# ========================================================
# Environment Variables & All .env files (STRICTLY IGNORED)
# ========================================================
.env*
*.env*
**/.env*

# Vercel
.vercel/
*/.vercel/

# TypeScript cache
*.tsbuildinfo
next-env.d.ts
*/next-env.d.ts
